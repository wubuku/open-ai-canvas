{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-contract.invalid/schemas/project.v1.schema.json",
  "title": "Observed v1 project/workbench DTOs; target approval pending",
  "$defs": {
    "project": {"type": "object", "required": ["id", "name", "type", "aspectRatio", "sourceType", "status", "revision", "createdAt", "updatedAt"], "properties": {"id": {"$ref": "common.v1.schema.json#/$defs/id"}, "name": {"type": "string"}, "type": {"type": "string"}, "aspectRatio": {"type": "string"}, "sourceType": {"type": "string"}, "status": {"type": "string"}, "revision": {"$ref": "common.v1.schema.json#/$defs/revision"}, "createdAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}, "updatedAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}}, "additionalProperties": true},
    "single": {"type": "object", "required": ["project"], "properties": {"project": {"$ref": "#/$defs/project"}}, "additionalProperties": true},
    "summary": {"allOf": [{"$ref": "#/$defs/single"}, {"required": ["canvasCount", "assetCount", "unitCount", "completedUnitCount"], "properties": {"canvasCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "assetCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "unitCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "completedUnitCount": {"$ref": "common.v1.schema.json#/$defs/count"}}}]},
    "list": {"allOf": [{"$ref": "common.v1.schema.json#/$defs/pagination"}, {"type": "object", "required": ["projects"], "properties": {"projects": {"type": ["array", "null"], "items": {"$ref": "#/$defs/summary"}}}, "additionalProperties": true}]},
    "unit": {"type": "object", "required": ["id", "projectId", "kind", "title", "sourceText", "wordCount", "status", "position", "createdAt", "updatedAt"], "properties": {"id": {"$ref": "common.v1.schema.json#/$defs/id"}, "projectId": {"$ref": "common.v1.schema.json#/$defs/id"}, "kind": {"type": "string"}, "title": {"type": "string"}, "sourceText": {"type": "string"}, "wordCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "status": {"type": "string"}, "position": {"type": "integer"}, "createdAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}, "updatedAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}}, "additionalProperties": true},
    "unit-single": {"type": "object", "required": ["unit"], "properties": {"unit": {"$ref": "#/$defs/unit"}}, "additionalProperties": true},
    "unit-list": {"type": "object", "required": ["units"], "properties": {"units": {"type": ["array", "null"], "items": {"$ref": "#/$defs/unit"}}, "canvasCounts": {"type": ["object", "null"], "additionalProperties": {"$ref": "common.v1.schema.json#/$defs/count"}}}, "additionalProperties": true},
    "reorder": {"type": "object", "required": ["unitIds"], "properties": {"unitIds": {"type": "array", "items": {"$ref": "common.v1.schema.json#/$defs/id"}, "uniqueItems": true}}, "additionalProperties": true},
    "link": {"type": "object", "required": ["id", "projectId", "canvasId", "unitId", "role", "createdAt"], "properties": {"id": {"$ref": "common.v1.schema.json#/$defs/id"}, "projectId": {"$ref": "common.v1.schema.json#/$defs/id"}, "canvasId": {"$ref": "common.v1.schema.json#/$defs/id"}, "unitId": {"$ref": "common.v1.schema.json#/$defs/id"}, "role": {"type": "string"}, "createdAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}}, "additionalProperties": true},
    "link-single": {"type": "object", "required": ["link"], "properties": {"link": {"$ref": "#/$defs/link"}}, "additionalProperties": true},
    "unlink-unit": {"type": "object", "required": ["canvasId", "unitId"], "properties": {"canvasId": {"$ref": "common.v1.schema.json#/$defs/id"}, "unitId": {"$ref": "common.v1.schema.json#/$defs/id"}}, "additionalProperties": true},
    "unlink": {"type": "object", "required": ["canvasId"], "properties": {"canvasId": {"$ref": "common.v1.schema.json#/$defs/id"}}, "additionalProperties": true},
    "canvas-page-summary": {"title": "Observed incomplete Go projection; D-11 pending, not authoritative document revision", "type": "object", "required": ["id", "title", "revision", "createdAt", "updatedAt"], "properties": {"id": {"$ref": "common.v1.schema.json#/$defs/id"}, "title": {"type": "string"}, "revision": {"const": 0}, "createdAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}, "updatedAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}}, "additionalProperties": true},
    "canvases": {"allOf": [{"$ref": "common.v1.schema.json#/$defs/page"}, {"type": "object", "required": ["canvases", "canvasUnitLinks"], "properties": {"canvases": {"type": ["array", "null"], "items": {"$ref": "#/$defs/canvas-page-summary"}}, "canvasUnitLinks": {"type": ["array", "null"], "items": {"$ref": "#/$defs/link"}}}, "additionalProperties": true}]},
    "detail": {"allOf": [{"$ref": "#/$defs/single"}, {"required": ["units", "canvases", "canvasUnitLinks", "assets", "tasks"], "properties": {"units": {"type": ["array", "null"], "items": {"$ref": "#/$defs/unit"}}, "canvases": {"type": ["array", "null"], "items": {"$ref": "canvas.v1.schema.json#/$defs/summary"}}, "canvasUnitLinks": {"type": ["array", "null"], "items": {"$ref": "#/$defs/link"}}, "assets": {"type": ["array", "null"]}, "tasks": {"type": ["array", "null"]}}}]},
    "overview": {"type": "object", "required": ["metrics", "units"], "properties": {"metrics": {"type": "object", "required": ["unitCount", "completedUnitCount", "totalWordCount", "canvasCount", "assetCount", "shotCount"], "properties": {"unitCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "completedUnitCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "totalWordCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "canvasCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "assetCount": {"$ref": "common.v1.schema.json#/$defs/count"}, "shotCount": {"$ref": "common.v1.schema.json#/$defs/count"}}, "additionalProperties": true}, "units": {"type": ["array", "null"], "items": {"type": "object", "required": ["unit"], "properties": {"unit": {"$ref": "#/$defs/unit"}}, "additionalProperties": true}}}, "additionalProperties": true},
    "workspace": {"allOf": [{"$ref": "#/$defs/unit-single"}, {"required": ["workflows", "shots", "assets", "tasks"], "properties": {"workflows": {"type": ["array", "null"]}, "shots": {"type": ["array", "null"]}, "assets": {"type": ["array", "null"]}, "tasks": {"type": ["array", "null"]}}}]}
  }
}
